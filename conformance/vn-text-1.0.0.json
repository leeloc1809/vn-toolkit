{
  "schema": "vn-text-conformance/1",
  "library": "vn-text",
  "version": "1.0.0",
  "created": "2026-10-04",
  "description": "Cross-language conformance suite for vn-text. Every case is consumed verbatim by both the TypeScript and the Python test suites, which is what guarantees the two implementations agree byte-for-byte. This file is the moat: copy the library, not the data.",
  "functions": ["normalize", "deaccent", "stripStroke", "repairMojibake", "fold", "isVietnamese"],
  "cases": [
    { "id": "deaccent-001", "fn": "deaccent", "input": "Cái gì thế này", "expected": "Cai gi the nay" },
    { "id": "deaccent-002", "fn": "deaccent", "input": "Tiếng Việt", "expected": "Tieng Viet" },
    { "id": "deaccent-003", "fn": "deaccent", "input": "Nguyễn Văn An", "expected": "Nguyen Van An" },
    { "id": "deaccent-004", "fn": "deaccent", "input": "Đặng Minh", "expected": "Đang Minh", "note": "U+0110 has no canonical decomposition, so NFD cannot touch it and it must survive. This is the false negative that silently breaks Vietnamese search: a NFD-and-strip implementation yields 'Đang Minh' here, and nobody types 'Đang' to find 'Đặng'." },
    { "id": "deaccent-005", "fn": "deaccent", "input": "Bùi Thị Xuân", "expected": "Bui Thi Xuan" },
    { "id": "deaccent-006", "fn": "deaccent", "input": "Phạm Thị Cẩm", "expected": "Pham Thi Cam" },
    { "id": "deaccent-007", "fn": "deaccent", "input": "Hà Nội", "expected": "Ha Noi" },
    { "id": "deaccent-008", "fn": "deaccent", "input": "Đà Nẵng", "expected": "Đa Nang" },
    { "id": "deaccent-009", "fn": "deaccent", "input": "Cao Bằng", "expected": "Cao Bang" },
    { "id": "deaccent-010", "fn": "deaccent", "input": "Hội An", "expected": "Hoi An" },
    { "id": "deaccent-011", "fn": "deaccent", "input": "Hồ Chí Minh", "expected": "Ho Chi Minh" },
    { "id": "deaccent-012", "fn": "deaccent", "input": "Võ Nguyên Giáp", "expected": "Vo Nguyen Giap" },
    { "id": "deaccent-013", "fn": "deaccent", "input": "Trần Đại Nghĩa", "expected": "Tran Đai Nghia", "note": "Đ (U+0110) survives deaccent exactly like in deaccent-004. Stripping tone marks must not rewrite letter identity." },
    { "id": "deaccent-014", "fn": "deaccent", "input": "Lê Duẩn", "expected": "Le Duan" },
    { "id": "deaccent-015", "fn": "deaccent", "input": "Mai Thúc Loan", "expected": "Mai Thuc Loan" },
    { "id": "deaccent-016", "fn": "deaccent", "input": "Ngô Đình Diệm", "expected": "Ngo Đinh Diem" },
    { "id": "deaccent-017", "fn": "deaccent", "input": "Bùi Xuân Phái", "expected": "Bui Xuan Phai" },
    { "id": "deaccent-018", "fn": "deaccent", "input": "Nguyễn Du", "expected": "Nguyen Du" },
    { "id": "deaccent-019", "fn": "deaccent", "input": "Đặng Dung", "expected": "Đang Dung" },
    { "id": "deaccent-020", "fn": "deaccent", "input": "Trịnh Công Sơn", "expected": "Trinh Cong Son" },
    { "id": "deaccent-021", "fn": "deaccent", "input": "Phạm Văn Đồng", "expected": "Pham Van Đong" },
    { "id": "deaccent-022", "fn": "deaccent", "input": "Võ Văn Tần", "expected": "Vo Van Tan" },
    { "id": "deaccent-023", "fn": "deaccent", "input": "Hồ Tùng Mậu", "expected": "Ho Tung Mau" },
    { "id": "deaccent-024", "fn": "deaccent", "input": "Lý Thường Kiệt", "expected": "Ly Thuong Kiet" },
    { "id": "deaccent-025", "fn": "deaccent", "input": "Trần Hưng Đạo", "expected": "Tran Hung Đao" },
    { "id": "deaccent-026", "fn": "deaccent", "input": "Trần Quốc Toản", "expected": "Tran Quoc Toan" },
    { "id": "deaccent-027", "fn": "deaccent", "input": "Nguyễn Trung Trực", "expected": "Nguyen Trung Truc" },
    { "id": "deaccent-028", "fn": "deaccent", "input": "Quang Trung", "expected": "Quang Trung" },
    { "id": "deaccent-029", "fn": "deaccent", "input": "Tôn Đức Thắng", "expected": "Ton Đuc Thang" },
    { "id": "deaccent-030", "fn": "deaccent", "input": "Đỗ Mười", "expected": "Đo Muoi" },
    { "id": "deaccent-031", "fn": "deaccent", "input": "Văn Cao", "expected": "Van Cao" },
    { "id": "deaccent-032", "fn": "deaccent", "input": "Nguyễn Thị Minh Khai", "expected": "Nguyen Thi Minh Khai" },
    { "id": "deaccent-033", "fn": "deaccent", "input": "Côn Đảo", "expected": "Con Đao" },
    { "id": "deaccent-034", "fn": "deaccent", "input": "Mũi Né", "expected": "Mui Ne" },
    { "id": "deaccent-035", "fn": "deaccent", "input": "Sơn Trà", "expected": "Son Tra" },
    { "id": "deaccent-036", "fn": "deaccent", "input": "Hạ Long", "expected": "Ha Long" },
    { "id": "deaccent-037", "fn": "deaccent", "input": "Nha Trang", "expected": "Nha Trang" },
    { "id": "deaccent-038", "fn": "deaccent", "input": "Đà Lạt", "expected": "Đa Lat" },
    { "id": "deaccent-039", "fn": "deaccent", "input": "Sa Pa", "expected": "Sa Pa" },
    { "id": "deaccent-040", "fn": "deaccent", "input": "Bến Tre", "expected": "Ben Tre" },
    { "id": "deaccent-041", "fn": "deaccent", "input": "Cà Mau", "expected": "Ca Mau" },
    { "id": "deaccent-042", "fn": "deaccent", "input": "Long Xuyên", "expected": "Long Xuyen" },
    { "id": "deaccent-043", "fn": "deaccent", "input": "Buôn Ma Thuột", "expected": "Buon Ma Thuot" },
    { "id": "deaccent-044", "fn": "deaccent", "input": "Thái Nguyên", "expected": "Thai Nguyen" },
    { "id": "deaccent-045", "fn": "deaccent", "input": "Quảng Ninh", "expected": "Quang Ninh" },
    { "id": "deaccent-046", "fn": "deaccent", "input": "Hải Phòng", "expected": "Hai Phong" },
    { "id": "deaccent-047", "fn": "deaccent", "input": "Cần Thơ", "expected": "Can Tho" },
    { "id": "deaccent-048", "fn": "deaccent", "input": "Vinh", "expected": "Vinh" },
    { "id": "deaccent-049", "fn": "deaccent", "input": "cafe", "expected": "cafe" },
    { "id": "deaccent-050", "fn": "deaccent", "input": "café", "expected": "cafe", "note": "General Unicode, not Vietnamese-specific: é is U+00E9 and decomposes normally." },
    { "id": "deaccent-051", "fn": "deaccent", "input": "ЀЖ", "expected": "ЕЖ", "note": "Cyrillic Ѐ (U+0400) decomposes to Е + U+0300 and the mark is stripped." },
    { "id": "deaccent-052", "fn": "deaccent", "input": "ﬁ", "expected": "ﬁ", "note": "U+FB01 has only a compatibility decomposition, which NFD does not apply. Using NFKD here would silently change English text." },
    { "id": "deaccent-053", "fn": "deaccent", "input": "①", "expected": "①", "note": "No decomposition at all." },
    { "id": "deaccent-054", "fn": "deaccent", "input": "é", "expected": "e", "note": "Input arrives already decomposed (e + U+0301). Idempotency on NFD input." },
    { "id": "deaccent-055", "fn": "deaccent", "input": "ậ", "expected": "a", "note": "Circumflex U+0302 and dot-below U+0323 both fall in U+0300-U+036F." },
    { "id": "deaccent-056", "fn": "deaccent", "input": "ắ", "expected": "a", "note": "Breve U+0306 plus acute U+0301." },
    { "id": "deaccent-057", "fn": "deaccent", "input": "ỹ", "expected": "y", "note": "Tilde U+0303 plus dot-below U+0323." },
    { "id": "deaccent-058", "fn": "deaccent", "input": "đ̀", "expected": "đ", "note": "đ (U+0111) carrying a combining grave. The stroke letter survives, the tone does not." },
    { "id": "deaccent-059", "fn": "deaccent", "input": "Ð̀", "expected": "Ð", "note": "ETH (U+00D0) carrying a combining grave. ETH survives too." },
    { "id": "deaccent-060", "fn": "deaccent", "input": "Đ", "expected": "Đ" },
    { "id": "deaccent-061", "fn": "deaccent", "input": "đ", "expected": "đ" },
    { "id": "deaccent-062", "fn": "deaccent", "input": "Ð", "expected": "Ð" },
    { "id": "deaccent-063", "fn": "deaccent", "input": "ð", "expected": "ð" },
    { "id": "deaccent-064", "fn": "deaccent", "input": "Ðor", "expected": "Ðor", "note": "Icelandic name. The tone-removal step must not turn ETH into D." },
    { "id": "deaccent-065", "fn": "deaccent", "input": "", "expected": "" },
    { "id": "deaccent-066", "fn": "deaccent", "input": "123", "expected": "123" },
    { "id": "deaccent-067", "fn": "deaccent", "input": "1234567890", "expected": "1234567890" },
    { "id": "deaccent-068", "fn": "deaccent", "input": "!!!@@@###", "expected": "!!!@@@###", "note": "deaccent only touches combining marks; it never removes punctuation." },
    { "id": "deaccent-069", "fn": "deaccent", "input": "東京", "expected": "東京" },
    { "id": "deaccent-070", "fn": "deaccent", "input": "  leading and trailing  ", "expected": "  leading and trailing  ", "note": "deaccent never trims whitespace; that is fold's job." },
    { "id": "deaccent-071", "fn": "deaccent", "input": "HỌC SINH GIỎI", "expected": "HOC SINH GIOI" },
    { "id": "deaccent-072", "fn": "deaccent", "input": "Từ điển tiếng Việt", "expected": "Tu đien tieng Viet" },

    { "id": "stroke-001", "fn": "stripStroke", "input": "Đặng", "expected": "Dặng", "note": "Only the stroke letter changes. Tone marks are deaccent's job — stripStroke is deliberately the narrower transform." },
    { "id": "stroke-002", "fn": "stripStroke", "input": "đặng", "expected": "dặng" },
    { "id": "stroke-003", "fn": "stripStroke", "input": "Đ", "expected": "D" },
    { "id": "stroke-004", "fn": "stripStroke", "input": "đ", "expected": "d" },
    { "id": "stroke-005", "fn": "stripStroke", "input": "đđ", "expected": "dd" },
    { "id": "stroke-006", "fn": "stripStroke", "input": "ĐÀ NẴNG", "expected": "DÀ NẴNG", "note": "Only the stroke letter changes. Tone marks are left for deaccent to handle." },
    { "id": "stroke-007", "fn": "stripStroke", "input": "Ðor", "expected": "Ðor", "note": "ETH is not D-WITH-STROKE." },
    { "id": "stroke-008", "fn": "stripStroke", "input": "ðor", "expected": "ðor" },
    { "id": "stroke-009", "fn": "stripStroke", "input": "", "expected": "" },
    { "id": "stroke-010", "fn": "stripStroke", "input": "abcd", "expected": "abcd" },
    { "id": "stroke-011", "fn": "stripStroke", "input": "Đỗ Mười", "expected": "Dỗ Mười" },

    { "id": "mojibake-001", "fn": "repairMojibake", "input": "Ðảm baỏ", "expected": "Đảm baỏ", "note": "Only the Ð is repaired. The commonly cited form of this case is 'Ðảm baỏ' -> 'Đảm bảo', but that ALSO needs vowel composition (baỏ -> bảo), which is a different problem this library does not solve. See mojibake-014." },
    { "id": "mojibake-002", "fn": "repairMojibake", "input": "Ðại học", "expected": "Đại học" },
    { "id": "mojibake-003", "fn": "repairMojibake", "input": "Ðà Nẵng", "expected": "Đà Nẵng" },
    { "id": "mojibake-004", "fn": "repairMojibake", "input": "ðại", "expected": "đại" },
    { "id": "mojibake-005", "fn": "repairMojibake", "input": "Ð", "expected": "Đ" },
    { "id": "mojibake-006", "fn": "repairMojibake", "input": "ð", "expected": "đ" },
    { "id": "mojibake-007", "fn": "repairMojibake", "input": "Đặng", "expected": "Đặng", "note": "Already-correct text is untouched." },
    { "id": "mojibake-008", "fn": "repairMojibake", "input": "Không có gì cần sửa", "expected": "Không có gì cần sửa" },
    { "id": "mojibake-009", "fn": "repairMojibake", "input": "", "expected": "" },
    { "id": "mojibake-010", "fn": "repairMojibake", "input": "123!@#", "expected": "123!@#" },
    { "id": "mojibake-011", "fn": "repairMojibake", "input": "Ðor", "expected": "Đor", "note": "DELIBERATELY WRONG for an Icelandic name. repairMojibake is Vietnamese-biased by design; this case exists so that trade-off is pinned and cannot be changed silently. Use fold() instead when the corpus may contain Scandinavian text." },
    { "id": "mojibake-012", "fn": "repairMojibake", "input": "ðor", "expected": "đor", "note": "Same deliberate trade-off, lowercase." },
    { "id": "mojibake-013", "fn": "repairMojibake", "input": "ÐÐ", "expected": "ĐĐ", "note": "Every occurrence, not just the first." },
    { "id": "mojibake-014", "fn": "repairMojibake", "input": "lựơng", "expected": "lựơng", "note": "Vowel composition is NOT repaired. lựơng stays lựơng — that is VietnameseTextNormalizer's and underthesea's job, not ours." },
    { "id": "mojibake-015", "fn": "repairMojibake", "input": "Ä Ä¡ng", "expected": "Ä Ä¡ng", "note": "Byte-level mojibake is NOT recovered; that needs the original bytes. ftfy is the right tool." },
    { "id": "mojibake-016", "fn": "repairMojibake", "input": "Ðặng Minh Anh", "expected": "Đặng Minh Anh" },
    { "id": "mojibake-017", "fn": "repairMojibake", "input": "Ho Chi Minh", "expected": "Ho Chi Minh" },

    { "id": "fold-001", "fn": "fold", "input": "Cái gì thế này", "expected": "cai gi the nay" },
    { "id": "fold-002", "fn": "fold", "input": "  CÁI   GÌ  thế này ", "expected": "cai gi the nay", "note": "Case, runs of whitespace and surrounding space all collapse to one canonical key." },
    { "id": "fold-003", "fn": "fold", "input": "Đặng Minh Anh", "expected": "dang minh anh" },
    { "id": "fold-004", "fn": "fold", "input": "Nguyễn Văn An", "expected": "nguyen van an" },
    { "id": "fold-005", "fn": "fold", "input": "Hà Nội", "expected": "ha noi" },
    { "id": "fold-006", "fn": "fold", "input": "Đà Nẵng", "expected": "da nang" },
    { "id": "fold-007", "fn": "fold", "input": "Hồ Chí Minh", "expected": "ho chi minh" },
    { "id": "fold-008", "fn": "fold", "input": "TP. Hồ Chí Minh", "expected": "tp ho chi minh" },
    { "id": "fold-009", "fn": "fold", "input": "Phạm Thị Cẩm", "expected": "pham thi cam" },
    { "id": "fold-010", "fn": "fold", "input": "TUỔI", "expected": "tuoi" },
    { "id": "fold-011", "fn": "fold", "input": "xin chào", "expected": "xin chao" },
    { "id": "fold-012", "fn": "fold", "input": "ĐẶNG XUÂN", "expected": "dang xuan" },
    { "id": "fold-013", "fn": "fold", "input": "BÙI THỊ XUÂN", "expected": "bui thi xuan" },
    { "id": "fold-014", "fn": "fold", "input": "Quận 9", "expected": "quan 9" },
    { "id": "fold-015", "fn": "fold", "input": "Cộng Hòa", "expected": "cong hoa" },
    { "id": "fold-016", "fn": "fold", "input": "Đ/c", "expected": "d c" },
    { "id": "fold-017", "fn": "fold", "input": "Tên-Có-Dấu", "expected": "ten co dau" },
    { "id": "fold-018", "fn": "fold", "input": "Hà Nội, Việt Nam!", "expected": "ha noi viet nam" },
    { "id": "fold-019", "fn": "fold", "input": "SĐT: 0912.345.678", "expected": "sdt 0912 345 678" },
    { "id": "fold-020", "fn": "fold", "input": "user@example.com", "expected": "user example com" },
    { "id": "fold-021", "fn": "fold", "input": "50%", "expected": "50" },
    { "id": "fold-022", "fn": "fold", "input": "123456", "expected": "123456" },
    { "id": "fold-023", "fn": "fold", "input": "crème brûlée", "expected": "creme brulee" },
    { "id": "fold-024", "fn": "fold", "input": "Café Bar", "expected": "cafe bar" },
    { "id": "fold-025", "fn": "fold", "input": "東京 Tokyo", "expected": "東京 tokyo", "note": "Ideographs carry no diacritics and stay searchable." },
    { "id": "fold-026", "fn": "fold", "input": "Ðông Đăng", "expected": "ðong dang", "note": "ETH is lower-cased to ð but never turned into d. Đăng folds normally to dang." },
    { "id": "fold-027", "fn": "fold", "input": "é", "expected": "e", "note": "Already-decomposed input." },
    { "id": "fold-028", "fn": "fold", "input": "ạ̀", "expected": "a", "note": "Precomposed a-dot-below carrying a combining grave." },
    { "id": "fold-029", "fn": "fold", "input": "", "expected": "" },
    { "id": "fold-030", "fn": "fold", "input": "   ", "expected": "" },
    { "id": "fold-031", "fn": "fold", "input": "!!!@@@###", "expected": "" },
    { "id": "fold-032", "fn": "fold", "input": "a", "expected": "a" },
    { "id": "fold-033", "fn": "fold", "input": "Cẩm", "expected": "cam" },
    { "id": "fold-034", "fn": "fold", "input": "Đặng", "expected": "dang" },
    { "id": "fold-035", "fn": "fold", "input": "Nguyễn", "expected": "nguyen" },
    { "id": "fold-036", "fn": "fold", "input": "  multiple   spaces  ", "expected": "multiple spaces" },
    { "id": "fold-037", "fn": "fold", "input": "Long Xuyên", "expected": "long xuyen" },
    { "id": "fold-038", "fn": "fold", "input": "Buôn Ma Thuột", "expected": "buon ma thuot" },
    { "id": "fold-039", "fn": "fold", "input": "Cần Thơ", "expected": "can tho" },
    { "id": "fold-040", "fn": "fold", "input": "Đà Lạt", "expected": "da lat" },

    { "id": "normalize-001", "fn": "normalize", "input": "Cái gì thế này", "expected": "Cái gì thế này", "note": "Already NFC, must be a no-op." },
    { "id": "normalize-002", "fn": "normalize", "input": "Cái gì thế này", "expected": "Cái gì thế này", "note": "Input is NFD (a + U+0301); output must be the composed form." },
    { "id": "normalize-003", "fn": "normalize", "input": "đập", "expected": "đập", "note": "NFD input with D-WITH-STROKE composes to U+0111 + U+1EAD." },
    { "id": "normalize-004", "fn": "normalize", "input": "abc", "expected": "abc" },
    { "id": "normalize-005", "fn": "normalize", "input": "", "expected": "" },
    { "id": "normalize-006", "fn": "normalize", "input": "東京", "expected": "東京" },

    { "id": "isvn-001", "fn": "isVietnamese", "input": "Đặng", "expected": true },
    { "id": "isvn-002", "fn": "isVietnamese", "input": "đ", "expected": true },
    { "id": "isvn-003", "fn": "isVietnamese", "input": "Nguyễn", "expected": true },
    { "id": "isvn-004", "fn": "isVietnamese", "input": "ỳ", "expected": true },
    { "id": "isvn-005", "fn": "isVietnamese", "input": "Nguyen", "expected": false, "note": "Documented limitation: the most common Vietnamese surnames are pure ASCII and are not detected." },
    { "id": "isvn-006", "fn": "isVietnamese", "input": "hello", "expected": false },
    { "id": "isvn-007", "fn": "isVietnamese", "input": "", "expected": false },
    { "id": "isvn-008", "fn": "isVietnamese", "input": "東京", "expected": false },
    { "id": "isvn-009", "fn": "isVietnamese", "input": "café", "expected": false, "note": "é is U+00E9, outside the Vietnamese-specific block." },
    { "id": "isvn-010", "fn": "isVietnamese", "input": "Ð", "expected": false, "note": "ETH is U+00D0, not D-WITH-STROKE." }
  ]
}
