{
  "name": "@vntoolkit/vn-collate",
  "version": "0.1.0",
  "description": "Vietnamese collation sort keys, derived from ICU. Store the key in a binary column and ORDER BY it, because Postgres and MySQL have no Vietnamese collation. Zero runtime dependencies.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/leeloc1809/vn-toolkit.git",
    "directory": "packages/vn-collate-ts"
  },
  "bugs": {
    "url": "https://github.com/leeloc1809/vn-toolkit/issues"
  },
  "homepage": "https://github.com/leeloc1809/vn-toolkit#readme",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "vietnamese",
    "collation",
    "collate",
    "sort",
    "sort-key",
    "unicode",
    "icu",
    "postgres",
    "mysql",
    "i18n",
    "vietnam"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build && node ../../scripts/stage-license.mjs ."
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^7.0.2",
    "vitest": "^2.1.3"
  }
}
